APP_NAME=Abshir
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://abshir.example.invalid
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=abshir_production
DB_USERNAME=abshir_runtime
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=verify-full
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
FILESYSTEM_DISK=local
CAPTAIN_SESSION_API_ENABLED=false
# Supply key/password/TLS certificates through the deployment secret store.
# Review a restricted mail transport separately; no real mail credentials belong here.
